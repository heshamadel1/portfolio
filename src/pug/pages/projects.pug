              target='_blank'
            )
              i.fa-brands.fa-github(aria-hidden='true')
              | GitHub
            a.pl-lv(href='#', aria-label='View live demo', target='_blank')
              i.fa-solid.fa-arrow-up-right-from-square.fa-xs(aria-hidden='true')
              | Live

      // Project 03
      article.prj-card.rv.d2
        .prj-top.pt3(aria-hidden='true')
          .prj-num 03
          .prj-icon ⚛️
          span.prj-chip In Progress
