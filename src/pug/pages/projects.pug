// PROJECTS
section#projects(aria-label='Featured Projects')
  .sec
    .rv
      .ey.ey-c Selected Work
      h2.sec-h Featured #[em Projects] #[span.grt —]

    .prj-grid
      // Project 01
      article.prj-card.rv
        .prj-top.pt1(aria-hidden='true')
          .prj-num 01
          .prj-icon 🏗️
          span.prj-chip Completed
        .prj-body
          h3.prj-title RESTful API Development
          p.prj-desc
            | Backend application focused on building structured RESTful APIs, handling HTTP requests, managing resources, and implementing clean server-side architecture.
          .prj-tags(aria-label='Technologies used')
            span.prj-tag PHP
            span.prj-tag Laravel
            span.prj-tag REST API
            span.prj-tag MySQL
          .prj-links
            a.pl-gh(
              href='https://github.com/heshamadel1',
              aria-label='View source code on GitHub',
              target='_blank'
            )
              i.fa-brands.fa-github(aria-hidden='true')
              | GitHub
            a.pl-lv(href='#', aria-label='View live demo', target='_blank')
              i.fa-solid.fa-arrow-up-right-from-square.fa-xs(aria-hidden='true')
              | Live

      // Project 02
      article.prj-card.rv.d1
        .prj-top.pt2(aria-hidden='true')
          .prj-num 02
          .prj-icon 🗄️
          span.prj-chip Completed
        .prj-body
          h3.prj-title Database Management System
          p.prj-desc
            | Database-driven application demonstrating relational database design, data modeling, CRUD operations, relationships, and efficient SQL queries.
          .prj-tags(aria-label='Technologies used')
            span.prj-tag PHP
            span.prj-tag MySQL
            span.prj-tag PostgreSQL
            span.prj-tag SQL
          .prj-links
            a.pl-gh(
