//SKILLS

// SKILLS
section#skills(aria-label='Technical Skills')
  .sec
    .rv
      .ey.ey-i Technical Skills
      h2.sec-h Technologies I #[em work with] #[span.grw —]

    .sk-sections
      // Backend Core
      .rv
        .sg-head
          .sg-ico.sgi-b(aria-hidden='true') #[i.fa-brands.fa-laravel(style='color: var(--c-blue-l)')]
          .sg-name Backend Development
        .sk-grid
          .sk-card(data-tip='Server-side Development')
            .sk-icon #[i.devicon-php-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label PHP
          .sk-card(data-tip='PHP Web Application Framework')
            .sk-icon #[i.devicon-laravel-original.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label Laravel
          .sk-card(data-tip='RESTful API Design & Development')
            .sk-icon #[i.fa-solid.fa-network-wired(style='font-size: 2rem', aria-hidden='true')]
            .sk-label RESTful APIs
          .sk-card(data-tip='Object-Oriented Programming')
            .sk-icon #[i.fa-solid.fa-boxes-stacked(style='font-size: 2rem', aria-hidden='true')]
            .sk-label OOP
          .sk-card(data-tip='Application Architecture')
            .sk-icon(style='font-size: 2rem', aria-hidden='true') 🏗️
            .sk-label MVC Architecture
          .sk-card(data-tip='Clean & Maintainable Code')
            .sk-icon(style='font-size: 2rem', aria-hidden='true') ⚙️
            .sk-label Clean Code

      // Databases
      .rv.d1
        .sg-head
          .sg-ico.sgi-c(aria-hidden='true') #[i.fa-solid.fa-database(style='color: var(--c-cyan-l)')]
          .sg-name Databases & Storage
        .sk-grid
          .sk-card(data-tip='Relational Database Management')
            .sk-icon #[i.devicon-mysql-plain-wordmark(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label MySQL
          .sk-card(data-tip='Advanced Relational Database')
            .sk-icon #[i.devicon-postgresql-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label PostgreSQL
          .sk-card(data-tip='Database Queries')
            .sk-icon(style='font-size: 2rem', aria-hidden='true') 🗃️
            .sk-label SQL
          .sk-card(data-tip='Database Relationships & Design')
            .sk-icon #[i.devicon-azuresqldatabase-plain.colored(style='font-size: 2rem', aria-hidden='true')]
            .sk-label Database Design

      // Frontend & Development Tools
      .rv.d2
        .sg-head
          .sg-ico.sgi-v(aria-hidden='true') #[i.fa-brands.fa-react(style='color: var(--c-vio-l)')]
          .sg-name Development Tools
        .sk-grid
          .sk-card(data-tip='Version Control')
            .sk-icon #[i.devicon-git-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label Git
          .sk-card(data-tip='Remote Code Repositories')
            .sk-icon #[i.devicon-github-original(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label GitHub
          .sk-card(data-tip='Containerization')
            .sk-icon #[i.devicon-docker-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label Docker
          .sk-card(data-tip='Linux Environment')
            .sk-icon #[i.devicon-linux-plain(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label Linux
          .sk-card(data-tip='Development Environment')
            .sk-icon #[i.devicon-vscode-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label VS Code
      // Frontend & Tools
      .rv.d1
        .sg-head
          .sg-ico.sgi-v(aria-hidden='true') #[i.fa-brands.fa-react(style='color: var(--c-vio-l)')]
          .sg-name Frontend & Development Tools
        .sk-grid
          .sk-card(data-tip='Modern JavaScript')
            .sk-icon #[i.devicon-javascript-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label JavaScript
          .sk-card(data-tip='Component-based UI Development')
            .sk-icon #[i.devicon-react-original.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label React.js
          .sk-card(data-tip='Modern React Framework')
            .sk-icon #[i.devicon-nextjs-plain.colored(style='font-size: 2.1rem', aria-hidden='true')]
            .sk-label Next.js
